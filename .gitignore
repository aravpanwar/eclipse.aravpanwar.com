__pycache__/
*.pyc
.pytest_cache/
.venv/

# OSM extracts are gigabytes and re-downloadable from Geofabrik.
data/cache/osm/
*.osm.pbf

# GeoNames archive, re-downloadable.
data/cache/*.zip

# The extracted lodging cache IS committed: it is small, and it means a site
# build never needs the multi-gigabyte extracts.

# Natural Earth country outlines, re-downloadable.
data/cache/ne_*.geojson

# IBM Plex fonts for scripts/build_images.py, re-downloadable.
data/cache/*.ttf

# NASA path tables for the homepage thumbnails, re-downloadable.
data/cache/SE*path.html

# ERA5 netcdf is large and re-downloadable from the CDS.
data/cache/cloud/*.nc

# Site data is generated by scripts/build_site_data.py, build_geojson.py and
# build_countries.py, but committed so the site is deployable straight from
# the repo.
